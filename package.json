{
  "name": "circahue",
  "version": "1.0.0",
  "description": "Circadian accent hues from clock time, season, and latitude — pure TypeScript, zero DOM",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "vectors",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && node scripts/export-artifacts.mjs",
    "artifacts": "node scripts/export-artifacts.mjs",
    "build:demo": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "npm run build && publint",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run publint",
    "prepublishOnly": "npm run quality"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/circahue/circahue.git"
  },
  "bugs": {
    "url": "https://github.com/circahue/circahue/issues"
  },
  "homepage": "https://circahue.isamarin.xyz/",
  "keywords": [
    "circadian",
    "hue",
    "color",
    "accent",
    "solar",
    "moon",
    "season",
    "css-variables",
    "time-of-day",
    "circahue",
    "light-hue"
  ],
  "author": "isamarin × IGRS",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
